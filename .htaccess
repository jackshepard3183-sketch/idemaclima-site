Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On

# Public files live under /public while the project root is the web directory.
RewriteRule ^(uploads|assets)/(.*)$ public/$1/$2 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [L,QSA]
</IfModule>
